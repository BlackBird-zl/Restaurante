-- Shared helpers for pgTAP files (included with \ir). Everything is created inside the
-- test transaction and rolled back at the end of each file.
create extension if not exists pgtap with schema extensions;
set search_path = public, extensions;
create schema if not exists tests;
grant usage on schema tests to anon, authenticated, service_role;

create temp table if not exists test_vars(k text primary key, v text);
grant all on test_vars to public;

create or replace function tests.set(p_k text, p_v text) returns text language sql as $$
  insert into test_vars values (p_k, p_v) on conflict (k) do update set v = excluded.v returning v $$;
create or replace function tests.get(p_k text) returns text language sql stable as $$ select v from test_vars where k = p_k $$;

create or replace function tests.uid(p_email text) returns uuid language sql stable security definer set search_path = '' as $$
  select id from auth.users where email = p_email $$;
create or replace function tests.rid(p_slug text) returns uuid language sql stable security definer set search_path = '' as $$
  select id from app_private.restaurants where slug = p_slug $$;
create or replace function tests.item(p_slug text, p_item text) returns uuid language sql stable security definer set search_path = '' as $$
  select mi.id from app_private.menu_items mi join app_private.restaurants r on r.id = mi.restaurant_id where r.slug = p_slug and mi.slug = p_item $$;
create or replace function tests.item_version(p_id uuid) returns integer language sql stable security definer set search_path = '' as $$
  select version from app_private.menu_items where id = p_id $$;
create or replace function tests.item_price(p_id uuid) returns integer language sql stable security definer set search_path = '' as $$
  select price_cents from app_private.menu_items where id = p_id $$;
create or replace function tests.tbl(p_slug text, p_label text) returns uuid language sql stable security definer set search_path = '' as $$
  select t.id from app_private.dining_tables t join app_private.restaurants r on r.id = t.restaurant_id where r.slug = p_slug and t.label = p_label $$;
create or replace function tests.q(p_sql text) returns jsonb language plpgsql security definer set search_path = '' as $$
  declare v jsonb; begin execute 'select to_jsonb(x) from (' || p_sql || ') x' into v; return v; end $$;
create or replace function tests.scalar(p_sql text) returns text language plpgsql security definer set search_path = '' as $$
  declare v text; begin execute p_sql into v; return v; end $$;

-- Switch identity. `set role` is allowed because the session user is the superuser.
create or replace function tests.login(p_email text) returns void language plpgsql as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config('request.jwt.claims', json_build_object('sub', tests.uid(p_email), 'role', 'authenticated', 'email', p_email)::text, true);
end $$;
create or replace function tests.as_anon() returns void language plpgsql as $$
begin
  perform set_config('role', 'anon', true);
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
end $$;
create or replace function tests.as_service() returns void language plpgsql as $$
begin
  perform set_config('role', 'service_role', true);
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
end $$;
create or replace function tests.reset() returns void language plpgsql as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', '', true);
end $$;
grant execute on all functions in schema tests to anon, authenticated, service_role;

create or replace function tests.digest(p_code text) returns text language sql immutable as $$
  select encode(extensions.digest(convert_to('test:' || p_code, 'UTF8'), 'sha256'), 'hex') $$;
grant execute on function tests.digest(text) to anon, authenticated, service_role;
