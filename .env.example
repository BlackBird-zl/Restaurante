# restaurant-os — environment variables. Names and illustrative values only; NO real secrets.
# Copy to .env.local (local) or configure in the hosting secret manager (staging/production).

# local | staging | production (seed/reset refuse to run when production)
APP_ENV=local

# Supabase project (public values: URL + publishable/anon key)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-or-anon-key
# Server-only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key
# Scripts only (migrations/seed/reset). Not used by the web app.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Hosts. Public sites: {slug}.APP_BASE_DOMAIN or verified custom domains.
APP_BASE_DOMAIN=localhost
# Central host for staff login, operation and admin (host[:port] as sent by browsers).
APP_STAFF_HOST=localhost:3000
# Hosts where /d/{slug} preview routing is allowed (never in production).
APP_PREVIEW_HOSTS=localhost:3000,127.0.0.1:3000
APP_URL_SCHEME=http
# Optional port appended to tenant URLs in local development.
APP_PUBLIC_PORT=3000

# Secrets (generate each with: openssl rand -base64 32)
GUEST_PIN_PEPPER=base64-32-bytes
QR_ENCRYPTION_KEY=base64-32-bytes
QR_ENCRYPTION_KEY_VERSION=1
# Optional previous key for rotation: QR_ENCRYPTION_KEY_PREVIOUS / QR_ENCRYPTION_KEY_PREVIOUS_VERSION
QR_CONTEXT_SECRET=base64-32-bytes
RATE_LIMIT_SALT=base64-32-bytes

# Local/scripts only: base for per-user demo passwords (<DEMO_SEED_PASSWORD>.<name>). Never set in production.
DEMO_SEED_PASSWORD=choose-a-local-value
